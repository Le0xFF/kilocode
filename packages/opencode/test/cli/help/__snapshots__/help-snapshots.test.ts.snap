exports[`Kilo CLI help-text snapshots every documented command emits stable help text: kilo acp --help 1`] = `
"kilo acp

start ACP (Agent Client Protocol) server

Opzioni:
  -h, --help         show help                                                            [booleano]
  -v, --version      show version number                                                  [booleano]
      --print-logs   print logs to stderr                                                 [booleano]
      --log-level    log level                  [stringa] [scelte: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure         run without external plugins                                         [booleano]
      --port         port to listen on                                     [numero] [predefinito: 0]
      --hostname     hostname to listen on                      [stringa] [predefinito: "127.0.0.1"]
      --mdns         enable mDNS service discovery (defaults hostname to 0.0.0.0)
                                                                     [booleano] [predefinito: false]
      --mdns-domain  custom domain name for mDNS service (default: kilo.local)
                                                               [stringa] [predefinito: "kilo.local"]
      --cors         additional domains to allow for CORS                [vettore] [predefinito: []]
      --cwd          working directory                 [stringa] [predefinito: "<HOME>"]
"
`;

exports[`Kilo CLI help-text snapshots every documented command emits stable help text: kilo mcp --help 1`] = `
"kilo mcp

manage MCP (Model Context Protocol) servers

Comandi:
  kilo mcp add [name]     add an MCP server
  kilo mcp list           list MCP servers and their status                              [alias: ls]
  kilo mcp auth [name]    authenticate with an OAuth-enabled MCP server
  kilo mcp logout [name]  remove OAuth credentials for an MCP server
  kilo mcp debug <name>   debug OAuth connection for an MCP server

Opzioni:
  -h, --help        show help                                                             [booleano]
  -v, --version     show version number                                                   [booleano]
      --print-logs  print logs to stderr                                                  [booleano]
      --log-level   log level                   [stringa] [scelte: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure        run without external plugins                                          [booleano]
"
`;

exports[`Kilo CLI help-text snapshots every documented command emits stable help text: kilo attach --help 1`] = `
"kilo attach <url>

attach to a running kilo server

Positionals:
  url  http://localhost:4096                                                   [stringa] [richiesto]

Opzioni:
  -h, --help          show help                                                           [booleano]
  -v, --version       show version number                                                 [booleano]
      --print-logs    print logs to stderr                                                [booleano]
      --log-level     log level                 [stringa] [scelte: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure          run without external plugins                                        [booleano]
      --dir           directory to run in                                                  [stringa]
  -c, --continue      continue the last session                                           [booleano]
  -s, --session       session id to continue                                               [stringa]
      --fork          fork the session when continuing (use with --continue or --session) [booleano]
  -p, --password      basic auth password (defaults to KILO_SERVER_PASSWORD)               [stringa]
  -u, --username      basic auth username (defaults to KILO_SERVER_USERNAME or 'kilo')     [stringa]
      --mini          start the minimal interactive interface        [booleano] [predefinito: false]
      --no-replay     disable mini session history replay on resume and after resize      [booleano]
      --replay-limit  cap visible mini replay to the newest N messages                      [numero]
"
`;

exports[`Kilo CLI help-text snapshots every documented command emits stable help text: kilo run --help 1`] = `
"kilo run [message..]

run kilo with a message

Positionals:
  message  message to send                                               [vettore] [predefinito: []]

Opzioni:
  -h, --help         show help                                                            [booleano]
  -v, --version      show version number                                                  [booleano]
      --print-logs   print logs to stderr                                                 [booleano]
      --log-level    log level                  [stringa] [scelte: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure         run without external plugins                                         [booleano]
      --command      the command to run, use message for args                              [stringa]
  -c, --continue     continue the last session                                            [booleano]
  -s, --session      session id to continue                                                [stringa]
      --fork         fork the session before continuing (requires --continue or --session)[booleano]
  -m, --model        model to use in the format of provider/model                          [stringa]
      --agent        agent to use                                                          [stringa]
      --format       format: default (formatted) or json (raw JSON events)
                                      [stringa] [scelte: "default", "json"] [predefinito: "default"]
  -f, --file         file(s) to attach to message                                          [vettore]
      --title        title for the session (uses truncated prompt if no value provided)    [stringa]
      --attach       attach to a running kilo server (e.g., http://localhost:4096)         [stringa]
  -p, --password     basic auth password (defaults to KILO_SERVER_PASSWORD)                [stringa]
  -u, --username     basic auth username (defaults to KILO_SERVER_USERNAME or 'kilo')      [stringa]
      --dir          directory to run in, path on remote server if attaching               [stringa]
      --port         port for the local server (defaults to random port if no value provided)
                                                                                            [numero]
      --variant      model variant (provider-specific reasoning effort, e.g., high, max, minimal)
                                                                                           [stringa]
      --thinking     show thinking blocks                                                 [booleano]
  -i, --interactive  run in direct interactive split-footer mode     [booleano] [predefinito: false]
      --auto         auto-approve permissions that are not explicitly denied (dangerous!)
                                                                     [booleano] [predefinito: false]
"
`;

exports[`Kilo CLI help-text snapshots every documented command emits stable help text: kilo debug --help 1`] = `
"kilo debug

debugging and troubleshooting tools

Comandi:
  kilo debug config        show resolved configuration
  kilo debug rg            ripgrep debugging utilities
  kilo debug file          file system debugging utilities
  kilo debug scrap         list all known projects
  kilo debug skill         list all available skills
  kilo debug snapshot      snapshot debugging utilities
  kilo debug startup       print startup timing
  kilo debug agent <name>  show agent configuration details
  kilo debug v2            debug v2 catalog and built-in plugins
  kilo debug info          show debug information
  kilo debug paths         show global paths (data, config, cache, state)
  kilo debug wait          wait indefinitely (for debugging)

