      --print-logs  print logs to stderr                                                  [booleano]
      --log-level   log level                   [stringa] [scelte: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure        run without external plugins                                          [booleano]
      --event       GitHub mock event to run the agent for                                 [stringa]
      --token       GitHub personal access token (github_pat_********)                     [stringa]
"
`;

exports[`Kilo CLI help-text snapshots every documented command emits stable help text: kilo db path --help 1`] = `
"kilo db path

print the database path

Opzioni:
  -h, --help        show help                                                             [booleano]
  -v, --version     show version number                                                   [booleano]
      --print-logs  print logs to stderr                                                  [booleano]
      --log-level   log level                   [stringa] [scelte: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure        run without external plugins                                          [booleano]
"
`;
